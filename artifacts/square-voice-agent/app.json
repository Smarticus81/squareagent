{
  "expo": {
    "name": "VoyceLab",
    "slug": "squareagent",
    "owner": "smarticus1",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voycelab",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080A"
    },
    "updates": {
      "url": "https://u.expo.dev/0157afb7-7402-4132-b38c-fa73c6c2a6b2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.voycelab.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VoyceLab uses your microphone to control your connected service by voice.",
        "NSSpeechRecognitionUsageDescription": "VoyceLab uses speech recognition for the wake-word feature.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "backgroundColor": "#07080A",
      "package": "com.voycelab.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VoyceLab to access your microphone for voice control."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": false,
          "microphonePermission": "Allow VoyceLab to access your microphone for voice control."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow VoyceLab to access your microphone for voice control.",
          "speechRecognitionPermission": "Allow VoyceLab to use speech recognition for the wake-word feature.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0157afb7-7402-4132-b38c-fa73c6c2a6b2"
      }
    }
  }
}
