{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env ./src/index.ts",
    "dev:local": "tsx watch --env-file=../../.env ./src/index.ts",
    "build": "tsx ./build.ts",
    "check:live-voice-providers": "tsx --env-file=../../.env ./scripts/check-live-voice-providers.ts",
    "check:live-voice-turns": "tsx --env-file=../../.env ./scripts/check-live-voice-turns.ts",
    "smoke:voice-pipelines": "tsx ./scripts/smoke-voice-pipelines.ts",
    "smoke:gemini-relay": "tsx ./scripts/smoke-gemini-relay.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.23",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/voicelab-core": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.3.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.8.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "svix": "^1.95.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}
