# Server
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://user:password@localhost:5432/voycelab
JWT_SECRET=replace-with-a-random-32-plus-character-session-secret
SECRETS_ENCRYPTION_KEY=replace-with-a-dedicated-random-32-plus-character-secret

# Provider API keys (canonical names)
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# OpenAI Realtime voice defaults
# The application already uses the GA WebRTC/client-secrets flow. Keep these
# explicit in each deployment so an old Railway variable cannot silently pin
# the voice pipeline to an earlier model or reasoning profile.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Full acoustic barge-in is opt-in; leave disabled for external speakers/Bluetooth.
ACOUSTIC_BARGE_IN=0

# Autonomous business control plane
# Safe default: everything is OFF until explicitly enabled in the deployment.
AUTONOMY_ENABLED=false
# Terra is the cost/intelligence default for medium+ strategy, research and support.
AUTONOMY_MODEL=gpt-5.6-terra
# Luna handles low-reasoning/high-volume lifecycle and outbound copy.
AUTONOMY_FAST_MODEL=gpt-5.6-luna
# Engineering triage can use Terra; full code repair defaults to Sol.
AUTONOMY_ENGINEERING_TRIAGE_MODEL=gpt-5.6-terra
AUTONOMY_ENGINEERING_MODEL=gpt-5.6-sol
# Account whose configured Gmail/Resend/SMTP sender is used for lifecycle,
# support, and outbound messages.
AUTONOMY_OPERATOR_USER_ID=
AUTONOMY_OPERATOR_ORG_ID=

# Independent authority switches. Keep code auto-merge false during initial burn-in.
AUTONOMY_ENABLE_OUTBOUND=false
AUTONOMY_ENABLE_CUSTOMER_SUCCESS=true
AUTONOMY_ENABLE_SUPPORT=true
AUTONOMY_ENABLE_CODE_WRITES=false
AUTONOMY_AUTO_MERGE_CODE=false
# Only use true if your repository genuinely has no CI/check system. Default false.
AUTONOMY_ALLOW_MERGE_WITHOUT_CHECKS=false

# Runtime GitHub credential for the deployed product-engineering worker. Use a
# narrowly scoped GitHub App/PAT with contents + pull-request rights to this repo.
GITHUB_AUTONOMY_TOKEN=
GITHUB_AUTONOMY_REPO=Smarticus81/squareagent
GITHUB_AUTONOMY_BASE_BRANCH=master

# Business authority / spend / communication ceilings
AUTONOMY_MAX_OUTBOUND_PER_DAY=120
AUTONOMY_MAX_OUTBOUND_PER_DOMAIN_DAY=3
AUTONOMY_MAX_AD_SPEND_CENTS_DAY=20000
AUTONOMY_MAX_AGENT_COMPUTE_CENTS_DAY=5000
AUTONOMY_MAX_AUTO_CREDIT_CENTS=2500
AUTONOMY_MAX_PRICE_TEST_PERCENT=15
AUTONOMY_MAX_CAMPAIGN_INCREASE_PERCENT=20
AUTONOMY_CODE_CANARY_PERCENT=5

# Scheduler cadences (minutes)
AUTONOMY_STRATEGY_INTERVAL_MINUTES=360
AUTONOMY_SUPPORT_INTERVAL_MINUTES=15
AUTONOMY_ACTIVATION_INTERVAL_MINUTES=60
AUTONOMY_PROMOTION_INTERVAL_MINUTES=10
# Override if the operator inbox contains unrelated mail.
AUTONOMY_SUPPORT_GMAIL_QUERY="in:inbox is:unread newer_than:7d"

# Platform password recovery email
AUTH_EMAIL_FROM="VoyceLab <no-reply@yourdomain.com>"
AUTH_RESEND_API_KEY=
# Or SMTP:
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_SECURE=false

# Square OAuth
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# Clerk Billing
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_PLAN_PRO_ID=
CLERK_PLAN_BUSINESS_ID=
CLERK_CHECKOUT_PRO_MONTHLY_URL=
CLERK_CHECKOUT_PRO_YEARLY_URL=
CLERK_CHECKOUT_BUSINESS_MONTHLY_URL=
CLERK_CHECKOUT_BUSINESS_YEARLY_URL=
CLERK_BILLING_PORTAL_URL=

# Optional
SESSION_SECRET=
LOG_LEVEL=debug
VITE_DEMO_BOOKING_URL=
VITE_SALES_EMAIL=hello@voycelab.ai
